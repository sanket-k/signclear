{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signclear.app/rules/_schema.json",
  "title": "SignClear Jurisdiction Rule Pack (rule_pack_v1)",
  "type": "object",
  "required": [
    "schema_version", "pack_id", "display_name", "jurisdiction",
    "contract_types", "verified_date", "rules", "expected_clauses"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "rule_pack_v1" },
    "pack_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "display_name": { "type": "string", "minLength": 3 },
    "jurisdiction": {
      "type": "object",
      "required": ["country", "state", "cities"],
      "additionalProperties": false,
      "properties": {
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "state": { "type": ["string", "null"] },
        "cities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "contract_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "residential_rental", "personal_loan", "employment_offer",
          "general", "commercial_rental", "insurance_policy"
        ]
      }
    },
    "verified_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "legal_basis": { "type": "string" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rule_id", "category", "title", "basis_type", "severity",
          "benchmark", "statutory_citation", "detection_hint", "negotiation_ask"
        ],
        "additionalProperties": false,
        "properties": {
          "rule_id": { "type": "string", "pattern": "^IN_[A-Z0-9_]+$" },
          "category": { "type": "string" },
          "title": { "type": "string" },
          "basis_type": {
            "enum": ["statutory_conflict", "above_local_norm", "missing_protection", "standard"]
          },
          "severity": {
            "enum": ["critical", "caution", "standard", "safe"]
          },
          "benchmark": {
            "type": "object",
            "required": ["metric", "typical_label"],
            "additionalProperties": true,
            "properties": {
              "metric": { "type": "string" },
              "typical_label": { "type": "string" }
            }
          },
          "statutory_citation": {
            "type": "object",
            "required": ["act", "section", "source_url"],
            "additionalProperties": false,
            "properties": {
              "act": { "type": "string" },
              "section": { "type": "string" },
              "source_url": { "type": "string", "format": "uri" }
            }
          },
          "detection_hint": { "type": "string", "minLength": 20 },
          "negotiation_ask": {
            "type": "object",
            "required": ["short_title", "polite_ask", "firm_ask", "replacement_wording"],
            "additionalProperties": false,
            "properties": {
              "short_title": { "type": "string" },
              "polite_ask": { "type": "string" },
              "firm_ask": { "type": "string" },
              "replacement_wording": { "type": "string" }
            }
          }
        }
      }
    },
    "expected_clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "why_it_matters"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "why_it_matters": { "type": "string" }
        }
      }
    }
  }
}