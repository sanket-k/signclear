# SignClear environment contract
# Copy to .env.local for local dev (VERCEL CLI) or set in the Vercel dashboard.
# NEVER commit real keys. Never expose these to public/ — they are server-only.

# ── LLM provider switch ─────────────────────────────────────────────
# One variable controls the gateway. Everything else stays the same.
#   openrouter  → free tier, works pre-event (DEFAULT)
#   anthropic   → flip only when event credits activate (orientation / after 1:00 PM)
LLM_PROVIDER=openrouter

# Used when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ── Speech (Sarvam) ─────────────────────────────────────────────────
# saaras:v4 (STT, mode=codemix) + bulbul:v4-flash (TTS).
# If this key is missing, the client falls back to speechSynthesis.
SARVAM_API_KEY=

# ── Model routing (locked; do not build model pickers) ──────────────
# OCR/triage: Haiku 5.5 @ temperature 0.0
# Audit:      Sonnet 5.5 @ temperature 0.1
# Q&A:        Sonnet 5.5 @ temperature 0.15
